---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
---

<Layout>
  <MetaPage slot="head" />
  <profile-intro>
    <h1 style="display:none">jvf.dev</h1>
    <p class="role">Engine Programmer</p>
    <p>
      I’m drawn to the systems behind the software. I write about what I learn
      while building and exploring them.
    </p>
  </profile-intro>
  <quote-entry>
    <blockquote>
      <p class="opening">All men dream—but not equally.</p>
      <p>
        Those who dream by night, in the dusty recesses of their minds, wake in
        the day to find it was vanity. But the dreamers of the day are dangerous
        men, for they may act their dreams with open eyes, to make it possible.
      </p>
    </blockquote>
    <cite>T. E. Lawrence, <i>Seven Pillars of Wisdom</i></cite>
  </quote-entry>
</Layout>

<style>
  profile-intro {
    display: block;
    margin-block-end: var(--space-s);
    font-size: var(--step-0);
    color: var(--muted-foreground);

    h1 {
      margin: 0;
      font-size: var(--step-2);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-medium);
      color: var(--foreground);
    }

    .role {
      margin-block: var(--space-3xs);
      color: var(--foreground);
    }

    p:last-child {
      margin-block: 0;
    }
  }

  quote-entry {
    display: block;
    padding-inline-start: var(--space-m);
    border-inline-start: 2px solid var(--border);
    font-size: var(--step--1);
    line-height: calc(var(--leading-offset) + 1em);
    color: var(--muted-foreground);

    blockquote {
      margin: 0;
      font-style: italic;
    }

    .opening {
      font-weight: var(--font-weight-medium);
      color: var(--foreground);
      margin-block-end: var(--space-2xs);
    }

    p {
      margin: 0;
    }

    cite {
      display: block;
      margin-block-start: var(--space-xs);
      font-style: normal;
    }
  }
</style>
